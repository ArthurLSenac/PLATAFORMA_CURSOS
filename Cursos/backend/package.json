{
  "name": "plataforma-cursos-backend",
  "version": "1.0.0",
  "description": "API REST da plataforma de cursos Lumina Academy (Node.js + Express + MySQL + JWT)",
  "type": "module",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node database/setup.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "yauzl": "^3.4.0"
  }
}
