# Modelo público: copie para .env e configure somente na sua máquina.
# Não envie .env ao GitHub.
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=plataforma_cursos
# Preencha com uma chave aleatória de pelo menos 32 caracteres.
JWT_SECRET=
JWT_EXPIRES_IN=8h
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@example.com
# Escolha sua senha local com pelo menos 8 caracteres.
ADMIN_SENHA=
UPLOAD_MAX_VIDEO_MB=2048
UPLOAD_MAX_ARQUIVO_MB=200
UPLOAD_MAX_IMAGEM_MB=5
UPLOAD_MAX_ZIP_MB=4096
